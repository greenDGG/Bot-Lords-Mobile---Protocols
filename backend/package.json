{
  "name": "botigg-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node --openssl-legacy-provider dist/main.js",
    "dev": "node --openssl-legacy-provider -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "migrate": "npx ts-node scripts/migrate-json-to-db.ts",
    "migrate:autostart": "npx ts-node scripts/migrate-autostart.ts",
      "migrate:hunt": "npx ts-node scripts/migrate-hunt-enable.ts",
      "migrate:hunt-payload": "npx ts-node scripts/migrate-hunt-payload.ts",
      "migrate:lucky-cards": "npx ts-node scripts/migrate-lucky-cards.ts",
      "migrate:lucky-exchange": "npx ts-node scripts/migrate-lucky-exchange.ts",
    "migrate:eventos-diarios": "npx ts-node scripts/migrate-eventos-diarios.ts",
    "migrate:supply": "npx ts-node scripts/migrate-supply-capacity.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.0",
    "firebase-admin": "^14.3.0",
    "google-play-scraper": "^10.1.3",
    "mongoose": "^9.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  }
}
