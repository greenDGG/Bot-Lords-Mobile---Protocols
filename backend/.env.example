# Copia este archivo a `.env` y completa los valores.
# NUNCA subas `.env` a git (ya está en .gitignore).

# Llave DES del protocolo de Lords Mobile (8 bytes en hex)
DES_KEY=4C2A232940212638

# Servidor de juego por defecto (si el proxy no devuelve IP:puerto)
SERVER_IP=34.168.134.194
SERVER_PORT=10714

# URI de conexión a MongoDB (usa tu propia instancia)
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/botigg?retryWrites=true&w=majority

# Directorios (opcional, por defecto ./access y ./logs相对于 backend/)
# ACCESS_DIR=/access
# LOG_DIR=/logs

# Firebase Cloud Messaging (para notificaciones push)
# Puede ser la ruta al archivo JSON de la service account o el JSON inline
# FIREBASE_SERVICE_ACCOUNT=/ruta/a/service-account.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}

# Discord Bot (para notificaciones de eventos globales)
DISCORD_BOT_TOKEN=TuTokenDeDiscordAqui
DISCORD_APP_ID=TuAppIdDeDiscordAqui
DISCORD_GUILD_ID=TuGuildIdParaDeployDeSlashCommands
